PORT=8080
HOST=0.0.0.0
DATA_DIR=./data
BOX_IMAGE=boxedagent/ubuntu-dev:24.04
LOG_LEVEL=info
# 上传文件和图片 Prompt JSON 的最大体积限制，单位 MB
MAX_UPLOAD_MB=128

# 公网部署必须设置一个足够长的随机访问 Token，例如：openssl rand -base64 32
BOXEDAGENT_TOKEN=
# 可选：用于签名浏览器会话 Cookie，生产环境建议也设置为随机值
SESSION_SECRET=
# 可选：公网 HTTPS 地址；设置后 CORS 会限制到该 Origin，Cookie 会启用 Secure
PUBLIC_ORIGIN=

# 至少配置一个模型供应商凭据，Box 创建时会继承这些变量
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
